---
const { post } = Astro.props

const formattedDate = new Intl.DateTimeFormat("en-CA", {
  year: "numeric",
  month: "long",
  day: "numeric",
  }).format(new Date(post.frontmatter.pubDate))
  ---

  <div style="width: 18rem;"> 
    <div class="blogcard">
      <strong>{post.frontmatter.title}</strong>
      <p style="font-size:15px" class="date">[{formattedDate}]</p>
      <hr>
      <p style="font-size: 15px">{post.frontmatter.description}</p>
      <div class="tags">
        {post.frontmatter.tags.map((tag) => (
        <span class="tag">[{tag}]</span>
        ))}
      </div>
      <a style="float: right; font-size: 15px" href={post.url} class="arrow">Read More ➪</a>
    </div>
  </div>


<style>
  .blogcard {
    background-color: var(--grey);
    color: var(--pale-blue);
    overflow-y: auto;
    padding: 15px;
    border-radius: 8px;
  }

  .blogcard:hover {
    filter: brightness(1.1);
    cursor: pointer;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tag {
    color: var(--orange);
    padding: 2px 5px;
    border-radius: 4px;
    font-size: 13px;
  }


</style>
