
---
const props = Astro.props;
---

<dialog class="modal" {...props}>
  <div class="modal-page">
    <form method="dialog" class="modal-close-form">
      <button class="modal-close" aria-label="Close modal">
        [x]
      </button>
    </form>

    <div class="modal-content">
      <slot />
    </div>
  </div>
</dialog>

<style>
  .modal {
    border: none;
    padding: 0;
    background: transparent;
  }

  .modal::backdrop {
    background: color-mix(in srgb, var(--pale-blue) 20%, transparent);
  }

  .modal-page {
    position: relative;
    background-color: var(--dark-grey);
    color: var(--pale-blue);
    border-radius: 8px;
    max-width: 900px;
    width: 90vw;
    max-height: 85vh;
    overflow-y: auto;
    padding: 24px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
  }

  .modal-close-form {
    position: absolute;
    top: 12px;
    right: 16px;
    margin: 0;
  }

  .modal-close {
    background: none;
    border: none;
    color: var(--orange);
    font-family: "Kode Mono", monospace;
    font-size: 24px;
    cursor: pointer;
    line-height: 1;
  }

  .modal-close:hover {
    color: var(--yellow);
  }

  .modal-content {
    margin-top: 16px;
  }
</style>

