---
const { project } = Astro.props
---
<div class="projectcard">
  <h4>{project.title}</h4>
  <hr>
  <p class="description">{project.description}</p>
  {project.tags && project.tags.length > 0 && (
  <div class="tags">
    {project.tags.map((tag) => (
    <span class="tag">[{tag}]</span>
    ))}
  </div>
  )}
</div>

<style>
  .projectcard {
    background-color: var(--grey);
    color: var(--pale-blue);
    overflow-y: auto;
    padding: 15px;
    border-radius: 8px;
  }

  .projectcard:hover {
    filter: brightness(1.5);
    cursor: pointer;
  }

  .projectcard h4 {
    margin: 0 0 8px 0;
  }

  .description {
    font-size: 15px;
    margin: 0 0 12px 0;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    justify-content: center;
    align-items: center;
    text-align: center;
  }

  .tag {
    color: var(--orange);
    padding: 4px 10px;
    border-radius: 4px;
    font-size: 13px;
  }

</style>
