---
import NavBar from "../components/NavBar.astro";
import Modal from "../components/Modal.astro";
import ThemeIcon from "../components/ThemeIcon.astro";
import '@fontsource/kode-mono';
import "../styles/global.css";
const props = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="AJ's personal web page" />
    <meta
      name="keywords"
      content="AJ Montajes, personal website, home page, UBC, intern, software, developer, portfolio"
    />
    <meta name="author" content="AJ Montajes" />
    <meta property="og:title" content={props.title} />
    <meta
      property="og:description"
      content="AJ Montajes's personal web page"
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://montajes.dev" />
    <title>{props.title} — AJ</title>
    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/katex@0.15.2/dist/katex.min.css"
        />
    <script is:inline>
      (function() {
        const theme = localStorage.getItem('theme') || 'light';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    <header>
      <div
          style="display: flex; flex-direction: row; align-items: center; row-gap: 10px; justify-content: center; flex-wrap: wrap"
        >
        <h3 style="padding-right: 20px">AJ's Web</h3>
        <NavBar title={props.title} />
        <ThemeIcon />

      </div>
    </header>
    <slot />
    <footer>


      <div style="padding-top: 20px; display: flex; align-items: center; justify-content: center">
        <div style="font-size: 15px">
          As a settler, I want to acknowledge that I live, work, and learn on the traditional, ancestral, and unceded territories of the
          <a href="https://musqueam.bc.ca/">xʷməθkʷəy̓əm</a>,
          <a href="https://squamish.net/">Sḵwx̱wú7mesh</a>, and
          <a href="https://twnation.ca/">səlilwətaɬ</a>
          Nations.
        </div>
      </div>

      <div style="padding-top: 20px; display: flex; align-items: center; justify-content: center">
        <div style="font-size: 15px">
          This website is inspired by a fellow UBC student <a href="https://ronf.dev/">ronf.dev</a>.
        </div>
      </div>


      <div style="padding-top: 25px; flex-direction: row; row-gap: 10px; display: flex; align-items: center; justify-content: center">
        <a href="https://github.com/montajesaj1/aj-dev/" style="font-size: 15px; font-family: "Kode Mono", monospace; "> [source code] </a>
        <a style="font-size: 15px; font-family: "Kode Mono", monospace;"  onclick="document.getElementById('about-modal').showModal()">
          [contact me]
        </a>

        <Modal id="about-modal">
          <header>
            <h3>Contact Me</h3>
          </header>
          <div style="flex-direction: row; row-gap: 10px">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-linkedin" viewBox="0 0 16 16">
              <path d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854zm4.943 12.248V6.169H2.542v7.225zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248S2.4 3.226 2.4 3.934c0 .694.521 1.248 1.327 1.248zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225z"/>
            </svg>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-envelope" viewBox="0 0 16 16">
              <path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1zm13 2.383-4.708 2.825L15 11.105zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741M1 11.105l4.708-2.897L1 5.383z"/>
            </svg>
          </div>
        </Modal>

      </div>

    </footer>
  </body>
</html>
