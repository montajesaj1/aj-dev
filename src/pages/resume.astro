      to="Dec 2024"
      icon="ubc-logo.jpg"
      >
      <ul>
        <li>
          Teaching Assistant for Professor Conati in COGS 303 - Cognitive Systems Research Methods class.
        </li>
      </ul>
      </ResumeItem>

    <ResumeItem
